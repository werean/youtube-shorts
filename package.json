{
  "name": "youtube-shorts",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "install:all": "bun install && cd frontend && bun install",
    "dev": "concurrently \"bun run dev:backend\" \"bun run dev:frontend\"",
    "dev:backend": "bun run scripts/dev-backend.ts",
    "dev:frontend": "cd frontend && bun run dev",
    "build": "bun run build:frontend",
    "build:backend": "echo Backend is 100% Python FastAPI (no build required)",
    "build:frontend": "cd frontend && bun run build",
    "start": "bun run scripts/dev-backend.ts"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
